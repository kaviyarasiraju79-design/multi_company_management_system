# API server
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection (same server hosts the master DB and all 5 company DBs)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# Database used by the setup script to run CREATE DATABASE
PG_ADMIN_DB=postgres

# Master (routing) database name
MASTER_DB=mcms_master
